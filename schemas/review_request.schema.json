{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuliangshan.local/schemas/v0.4.1/review_request.schema.json",
  "title": "ReviewRequest",
  "description": "审核调用的冻结输入；request_id/task_id 指调用方源任务，所有版本在送审时绑定并持久化，回包不得改为当前行版本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_ref",
    "criteria",
    "requirements_excerpt",
    "request_id",
    "task_id",
    "requirements_revision",
    "plan_revision",
    "task_revision",
    "instruction_revision",
    "dispatcher_epoch",
    "review_id",
    "submission_id",
    "candidate_sha256",
    "round",
    "reviewer_instruction_revision",
    "reviewer_request_id",
    "reviewer_task_id",
    "reviewer_team_id",
    "reviewer_requirements_revision",
    "reviewer_plan_revision",
    "reviewer_task_revision",
    "reviewer_dispatcher_epoch",
    "reviewer_execution_epoch",
    "reviewer_policy_epoch"
  ],
  "properties": {
    "candidate_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "不可变的候选成果"
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "可选：对比基线"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^rc[0-9]{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "maxItems": 30,
      "minItems": 1
    },
    "requirements_excerpt": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "minItems": 1,
      "description": "与审核相关的需求原文摘录"
    },
    "focus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "requirements_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "instruction_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "dispatcher_epoch": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^review_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^sub_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "candidate_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_instruction_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_team_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^team_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_requirements_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_plan_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_task_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_dispatcher_epoch": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_execution_epoch": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "reviewer_policy_epoch": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    }
  }
}
