{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuliangshan.local/schemas/v0.4.1/submission.schema.json",
  "title": "Submission",
  "description": "Worker 提交的成果；TeamLead 转交时补充 team_lead_check。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "deliverables",
    "self_check",
    "request_id",
    "task_id",
    "team_id",
    "requirements_revision",
    "plan_revision",
    "task_revision",
    "instruction_revision",
    "dispatcher_epoch",
    "execution_epoch",
    "policy_epoch",
    "submission_id"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^sub_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "execution_epoch": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "做了什么"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^/work/"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "maxItems": 100,
      "minItems": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "method",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "实际执行的命令或核对方式"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 50
    },
    "self_check": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "met"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^ac[0-9]{1,3}$"
          },
          "met": {
            "enum": [
              "yes",
              "no",
              "partial"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 30,
      "minItems": 1
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 30
    },
    "used_memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory_id",
          "how_used",
          "load_id",
          "revision"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^((rul|fct|exp)-[0-9]{8}-[a-z0-9]{4}|skill:[a-z0-9]+(-[a-z0-9]+)*)$"
          },
          "how_used": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "load_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^load_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
            "x-runtime-field": true,
            "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
          }
        }
      },
      "maxItems": 30,
      "description": "每条使用声明引用实际 load_id；运行时按该不可变加载记录补 revision，禁止按当前 memory_meta 版本重新盖章。"
    },
    "team_lead_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "criteria_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "met"
            ],
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8,
                "pattern": "^ac[0-9]{1,3}$"
              },
              "met": {
                "enum": [
                  "yes",
                  "no",
                  "partial"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "maxItems": 30
        }
      },
      "description": "仅拥有该团队的 TeamLead 转交时填写；Worker 提交参数中移除，不能由 Worker 自我批准。",
      "x-runtime-field": true
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "team_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^team_[0-9A-HJKMNP-TV-Z]{26}$",
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "requirements_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "instruction_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "dispatcher_epoch": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-field": true,
      "description": "（运行时从已冻结的权威记录填写，模型不要提供）"
    }
  }
}
