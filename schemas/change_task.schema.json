{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://wuliangshan.local/schemas/v0.4.1/change_task.schema.json",
  "title": "CorrectRejectedTask",
  "description": "Dispatcher corrective revision of one host-captured rejected submission. Goal, constraints and acceptance criteria are preserved by the host.",
  "required": [
    "rationale",
    "correction"
  ],
  "properties": {
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "correction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
