{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuliangshan.local/schemas/v0.4.1/accept_candidate.schema.json",
  "title": "AcceptCandidate",
  "description": "Dispatcher business decision about one host-captured current candidate; IDs, versions and file hashes are host-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed"],
  "properties": {
    "passed": {"type": "boolean"},
    "notes": {"type": "string", "minLength": 1, "maxLength": 8000},
    "criteria_results": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "met", "evidence"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^ac[0-9]{1,3}$"},
          "met": {"enum": ["yes", "no", "partial"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"passed": {"const": true}}}, "then": {"required": ["criteria_results"]}}]
}
