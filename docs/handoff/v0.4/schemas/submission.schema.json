{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuliangshan.local/schemas/submission.schema.json",
  "title": "Submission",
  "description": "Worker 提交的成果；TeamLead 转交时补充 team_lead_check。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "deliverables",
    "self_check"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^sub_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "（运行时填写，模型不要提供）"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "（运行时填写，模型不要提供）"
    },
    "requirements_rev": {
      "type": "integer",
      "minimum": 1,
      "description": "提交时 Worker 的 applied_rev（运行时填写，模型不要提供）"
    },
    "execution_epoch": {
      "type": "integer",
      "minimum": 1,
      "description": "（运行时填写，模型不要提供）"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "做了什么"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^/work/"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "maxItems": 100,
      "minItems": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "method",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "实际执行的命令或核对方式"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 50
    },
    "self_check": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "met"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^ac[0-9]{1,3}$"
          },
          "met": {
            "enum": [
              "yes",
              "no",
              "partial"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 30,
      "minItems": 1
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 30
    },
    "used_memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memory_id",
          "how_used"
        ],
        "properties": {
          "memory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^((rul|fct|exp)-[0-9]{8}-[a-z0-9]{4}|skill:[a-z0-9]+(-[a-z0-9]+)*)$"
          },
          "how_used": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "maxItems": 30,
      "description": "实际用到的记忆；revision 由运行时按 memory_loads 补全"
    },
    "team_lead_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "criteria_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "met"
            ],
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8,
                "pattern": "^ac[0-9]{1,3}$"
              },
              "met": {
                "enum": [
                  "yes",
                  "no",
                  "partial"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "maxItems": 30
        }
      },
      "description": "TeamLead 用 forward_submission 转交时填写"
    }
  }
}
