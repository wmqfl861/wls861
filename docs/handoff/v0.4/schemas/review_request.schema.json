{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuliangshan.local/schemas/review_request.schema.json",
  "title": "ReviewRequest",
  "description": "调用审核能力（如 review.review_code）的输入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_ref",
    "criteria",
    "requirements_excerpt"
  ],
  "properties": {
    "candidate_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "不可变的候选成果"
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "可选：对比基线"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^rc[0-9]{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "maxItems": 30,
      "minItems": 1
    },
    "requirements_excerpt": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30,
      "minItems": 1,
      "description": "与审核相关的需求原文摘录"
    },
    "focus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "description": "（运行时填写，模型不要提供）"
    }
  }
}
