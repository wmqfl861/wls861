{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wuliangshan.local/schemas/review_verdict.schema.json",
  "title": "ReviewVerdict",
  "description": "审核结论。不通过的报告也是合格的审查交付。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "candidate_ref",
    "summary",
    "findings"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "changes_requested",
        "inconclusive"
      ]
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "requirements_rev": {
      "type": "integer",
      "minimum": 1,
      "description": "（运行时填写，模型不要提供）"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "description": "（运行时填写，模型不要提供）"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^f[0-9]{1,3}$"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 50
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "changes_requested"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
